# =============================================================================
# .env.example — Environment variables for AI Resume Analyzer Pro
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ---------- Flask ----------
SECRET_KEY="change-this-to-a-long-random-string"
FLASK_ENV=development
PORT=5000

# ---------- Database ----------
# For PostgreSQL (Docker):
DATABASE_URL="postgresql://resumeuser:resumepass@db:5432/resumeanalyzer"
POSTGRES_USER=resumeuser
POSTGRES_PASSWORD=resumepass
POSTGRES_DB=resumeanalyzer
POSTGRES_PORT=5432

# For SQLite (local dev, non-Docker):
# DATABASE_URL="sqlite:///ai_resume_analyzer.db"

# ---------- Google Gemini AI ----------
GEMINI_API_KEY="your-gemini-api-key-here"

# ---------- Google OAuth ----------
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"

# ---------- Facebook OAuth ----------
FACEBOOK_OAUTH_CLIENT_ID="your-facebook-app-id"
FACEBOOK_OAUTH_CLIENT_SECRET="your-facebook-app-secret"

# ---------- Uploads ----------
MAX_CONTENT_LENGTH=8388608
REPORTS_PER_PAGE=10

# ---------- Security ----------
PREFERRED_URL_SCHEME=https

